{
  "servers": ["nats://NATS_HOST:4222"],
  "controller_claim_account": "AUTHORITATIVE_NATS_ACCOUNT",
  "controller_claim_bucket": "CONTROLLER_AUTHORITY_BUCKET",
  "controller_claim_key": "INSTALLATION_CONTROLLER_CLAIM_KEY",
  "ingestor_id": "INGESTOR_ID",
  "storage_id": "STORAGE_ID",
  "storage_root": "SESSION_STORAGE_PATH",
  "global_artifact_root": "GLOBAL_SCIENTIFIC_STORAGE_PATH",
  "recovery_journal_root": "SESSION_JOURNAL_PATH",
  "framework_journal": "FRAMEWORK_JOURNAL_PATH/framework.jsonl",
  "preservation_window_s": 30,
  "external_dependents": [
    {"component_type": "controller", "component_id": "CONTROLLER_ID"},
    {"component_type": "synchronization_manager", "component_id": "SYNCHRONIZATION_ID"},
    {"component_type": "acquisition_node", "component_id": "ACQUISITION_NODE_ID"}
  ],
  "result_window_s": 10,
  "retrieval_endpoints": {
    "ACQUISITION_NODE_ID": {
      "host": "ACQUISITION_NODE_HOST",
      "username": "SSH_USERNAME",
      "port": 22,
      "key_filename": "SSH_PRIVATE_KEY_PATH",
      "known_hosts_path": "SSH_KNOWN_HOSTS_PATH"
    }
  }
}
